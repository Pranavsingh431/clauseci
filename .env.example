# ===== Google (Drive read-only + Gmail compose) =====
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json
# Drive folder holding the contract PDFs. Get the id from the folder URL.
CONTRACT_DRIVE_FOLDER_ID=

